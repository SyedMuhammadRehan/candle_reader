# Dev-only demo entry point — kept at lib/main.dart so `flutter run` works
# at the project root. Not part of the published API.
lib/main.dart

# Leftover scaffolding from when this project was generated by `flutter create`.
# None of it belongs in the published package — consumers bring their own app.
android/
ios/
linux/
macos/
web/
windows/

# Build + IDE noise.
build/
.dart_tool/
.idea/
*.iml
.metadata
pubspec.lock

# The example carries its own pubspec and platform folders; published size
# stays small if we ship its source only. (Pub auto-includes example/ so
# contributors can view it on pub.dev.)
example/android/
example/ios/
example/linux/
example/macos/
example/web/
example/windows/
example/build/
example/.dart_tool/
example/pubspec.lock
